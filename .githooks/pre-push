#!/bin/sh
# Runs before every push: type check and the unit tests (no database or network needed). Same checks as CI.
echo "pre-push: running type check and tests..."
npm run typecheck --silent || {
  echo ""
  echo "Type check failed, so nothing was pushed. Fix the errors above, then push again."
  exit 1
}
npm test --silent || {
  echo ""
  echo "Tests failed, so nothing was pushed. Fix the failures above, then push again."
  exit 1
}
