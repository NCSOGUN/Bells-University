# Copy to .env.local and fill in. Never commit .env.local.
# Server-only secrets: never prefix these with NEXT_PUBLIC_ (tests/static.test.ts fails the build if you do).
DATABASE_URL=
MIGRATION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
SHARE_PEPPER=
DEMO_PASSWORD=

# Browser sign-in (D-021). EXACTLY these two NEXT_PUBLIC_ names are allowed, and they are the same values as
# SUPABASE_URL and SUPABASE_ANON_KEY above. The anon/publishable key is public by design (RLS is deny-all).
# NEVER put the service-role key here. The browser client is for auth only; all data goes through /api/*.
# Vercel: add both in Project Settings > Environment Variables (Production, Preview, Development), then
# redeploy. NEXT_PUBLIC_ values are inlined at BUILD time, so a change needs a new build, not just a restart.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
